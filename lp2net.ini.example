# Copy next to LP2DX9.exe / LP2DX11.exe as lp2net.ini (install.bat does this for you).

# Your player name (up to 15 ASCII characters).
name = Player

# Leave `master` out: your game finds every LP2 Online server through the public directory.
# Set it to use only one server, e.g. a private one for your group: host or host:port (default 27900).
# master = 192.0.2.10

# true only if other players can reach this PC on `port` (UDP forwarded, or no NAT).
# Leave false and your traffic goes through the server's relay instead.
direct = false

# Local UDP port for game traffic. 0 = any free port. Set a fixed one when direct = true.
port = 0

# Writes lp2net.log next to the game. Attach it to bug reports.
log = true

# Debug: send all game traffic through the server's relay, even to players on this PC or LAN.
relay = false
