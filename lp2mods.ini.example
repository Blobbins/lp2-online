# Copy next to LP2DX9.exe / LP2DX11.exe as lp2mods.ini. Everyone in a lobby should use the same file.

[startup]
# Go straight from boot to the title screen (no Capcom/NVIDIA logos).
skip_logos = true
# Skip "Press Start": go from boot straight into the game's menus.
skip_title = true
# Allow a second copy of the game (it joins as "<name> 2"), e.g. to fill a lobby.
multi_instance = false
# Let the lobby host start a versus match alone (normally needs 2+ players, 3+ in team modes).
solo_start = true

[tuning]

[rules]

[unlocks]
# Own every customization part (heads, bodies, legs, backpacks) without the campaign/slot machine.
parts = true
# Own every Nom de Guerre (title).
titles = true
# Weapons and abilities unlock as your online career level rises (career points from matches):
# part of them each level, all of them by these levels. (weapons = true / abilities = true: all now.)
weapons_by_level = 20
abilities_by_level = 20

[bots]
# AI bots in Player Match lobbies (up to 11). A lobby you host starts with none: F7 adds one,
# F8 removes one. Players who join see your bots. Remove this section to turn bots off.
# Bots move only on Cube and the 3 other maps that have Training versions (the DLL adds their
# AI data once, keeping the originals in nativePC/arcXmlTmpPC as aArea_ONLINE_*.arc.orig).
